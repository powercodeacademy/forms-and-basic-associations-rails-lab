<h1>Create a Song</h1>

<%= form_with model: @song, local: true do |f| %>
  <p>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :artist_name %>
    <%= f.text_field :artist_name %>
  </p>

  <p>
    <%= f.label :genre_id, "Genre" %>
    <%= f.collection_select :genre_id, Genre.all, :id, :name %>
  </p>

  <p>
    <%= label_tag :song_notes_1, "Note 1" %>
    <%= text_field_tag "song[note_contents][]", nil, id: "song_notes_1" %>
  </p>

  <p>
    <%= label_tag :song_notes_2, "Note 2" %>
    <%= text_field_tag "song[note_contents][]", nil, id: "song_notes_2" %>
  </p>

  <%= f.submit %>
<% end %>
