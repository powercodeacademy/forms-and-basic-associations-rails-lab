<h1>Create a Song</h1>
<%= form_with model: @song, local: true do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title %>
  <br />
  <%= f.label :artist_name, "Artist" %>
  <%= f.text_field :artist_name %>
  <br />
  <%= f.label :genre %>
  <%= f.select(:genre_id, Genre.all.order(:name).pluck(:name, :id)) %>
  <br />
  <%= f.label :note_contents, "Notes" %>
  <%= f.text_field :note_contents, multiple: true, id: 'song_notes_1' %>
  <%= f.text_field :note_contents, multiple: true, id: 'song_notes_2' %>
  <br />
  <%= f.submit %>
<% end %>
