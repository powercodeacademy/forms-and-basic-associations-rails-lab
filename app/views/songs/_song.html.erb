
<%= form_with model: @song do |f| %>
  
  <%= f.label :title %>
  <%= f.text_field :title %>

  <%= f.label :artist_name %>
  <%= f.text_field :artist_name, list: 'artists-autocomplete' %>
  
  <datalist id="artists-autocomplete">
    <% Artist.all.each do |artist| %>
      <option value="<%= artist.name %>">
    <% end %>
  </datalist>

  <%= f.label :genre_id %>
  <%= f.collection_select :genre_id, Genre.all, :id, :name %>

  <%= f.label :note_contents, "Notes" %>
  <%= f.text_field :note_contents, multiple: true, id: "song_notes_1" %>
  <%= f.text_field :note_contents, multiple: true, id: "song_notes_2" %>
  <%= f.text_field :note_contents, multiple: true, id: "song_notes_3" %>

  <%= f.submit 'Create Song' %>
<% end %>
  
